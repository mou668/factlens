{
  "manifest_version": 3,
  "name": "FactLens Check",
  "version": "0.1.0",
  "description": "Review the visible article for claim and source signals with FactLens.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_title": "Check with FactLens",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
